  <rdf:Description rdf:about="#DayType">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#byreference"/>
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:space="preserve">-  The name attribute indicates the days of the week that a given DayType represents.&#xD;
-  If the name attribute is All, it represents all seven days of the week.&#xD;
-  If the name attribute is Weekday, it represents Monday through Friday.&#xD;
-  If the name attribute is Weekend, it represents Saturday and Sunday.&#xD;
- The name attribute is restricted to the following names: Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday, Weekday, Weekend, All.&#xD;
</rdfs:comment>
    <rdfs:label>DayType</rdfs:label>
    <rdfs:subClassOf rdf:resource="#IdentifiedObject"/>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/2013/CIM-schema-cim16#DayType"/>
  </rdf:Description>
