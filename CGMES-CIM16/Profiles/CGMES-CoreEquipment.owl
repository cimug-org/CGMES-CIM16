  <rdf:Description rdf:about="#SynchronousMachine">
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#byreference"/>
    <uml:hasStereotype rdf:resource="http://langdale.com.au/2005/UML#concrete"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:space="preserve">-  If a SynchronousMachine is not associated with a ReactiveCapabilityCurve, then the minQ and maxQ attributes will be used.  &#xD;
-  If a ReactiveCapabilityCurve is supplied, then the minQ and maxQ attributes are not required.&#xD;
-  If a synchronous condenser is being modeled so that there is no capability for real power output, the SynchronousMachine is not required to be associated with a GeneratingUnit.  In this case, the type and operatingMode attributes must both be set to condenser.&#xD;
</rdfs:comment>
    <rdfs:label>SynchronousMachine</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="X13Xdc20f33Xa3X128cae1a757Xa3X-6e1b"/>
